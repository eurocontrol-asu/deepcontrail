# Where packages/segmentation/scripts/train.py writes its runs.
# Copy this file to .env (git-ignored) and set your own paths:
#     cp .env.example .env
# A CLI flag (--checkpoint-root, --mlflow-uri) or a variable already set in the
# shell takes precedence over .env.

# Directory for the model checkpoints of each run.
DEEPCONTRAIL_CHECKPOINT_ROOT=/path/to/checkpoints

# MLflow tracking URI. For a local SQLite file use four slashes (absolute path):
# sqlite:////abs/path/mlflow.db
MLFLOW_TRACKING_URI=sqlite:////path/to/mlflow.db
